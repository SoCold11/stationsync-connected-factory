run = "npm run dev"
entrypoint = "src/main.tsx"
modules = ["nodejs-22"]
[env]
PORT = "5173"
[deployment]
run = ["sh", "-c", "npm run dev -- --host 0.0.0.0 --port ${PORT:-5173}"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev -- --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
